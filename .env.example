# Copy this file to .env and fill only the values needed by your run.
# Never commit the resulting .env file.

# OpenAI-compatible task-generation endpoint.
API_BASE=
API_KEY=
TASKGEN_MODEL=

# Required only for private or S3-compatible paper corpora.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional discovery providers.
SERPER_KEY=
JINA_API_KEY=
